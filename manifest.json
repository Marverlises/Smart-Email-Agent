{
  "manifest_version": 3,
  "name": "Smart Email Reply",
  "version": "0.4.4",
  "description": "在浏览器原生侧边栏中读取当前 Gmail 或 Outlook 会话历史，并生成多条可选择的 AI 回复。",
  "minimum_chrome_version": "116",
  "key": "",
  "permissions": [
    "activeTab",
    "sidePanel",
    "storage"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "打开 Smart Email Reply 侧边栏"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": [
        "https://mail.google.com/*",
        "https://outlook.office.com/*",
        "https://outlook.live.com/*",
        "https://outlook.cloud.microsoft/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
